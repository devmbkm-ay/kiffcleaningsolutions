# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kiffcleaning

# NextAuth configuration
NEXTAUTH_URL=https://www.kiffcleaningsolutions.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Admin panel credentials
ADMIN_EMAIL=admin@kiffcleaningsolutions.com
ADMIN_PASSWORD=secure-password-here

# Resend for email notifications
RESEND_API_KEY=re_your_key

# UploadThing for image uploads
UPLOADTHING_TOKEN=your_token

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.kiffcleaningsolutions.com
